{
  "name": "learning-is-fun",
  "version": "0.2.0",
  "description": "Learning is Fun – Hebrew & English letters, numbers and words for kids",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "format": "prettier --write src scripts",
    "recording-lists": "tsx scripts/recording-lists.ts",
    "voicelab": "tsx scripts/voicelab.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
